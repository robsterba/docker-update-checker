# Sample environment file for docker-update-checker
# Copy this file to .env and adjust values for your environment.

# Root directory inside the container where your Compose stacks are mounted
COMPOSE_ROOT=/compose

# Check interval in minutes
CHECK_INTERVAL_MINUTES=60

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Automatically recreate updated services after a successful pull
AUTO_RECREATE_AFTER_PULL=false

# Notification backend configuration
NOTIFY_ENABLED=false
NOTIFY_BACKEND=

# Webhook backend settings
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_METHOD=POST
NOTIFY_WEBHOOK_TIMEOUT=10

# MQTT backend settings
NOTIFY_MQTT_HOST=
NOTIFY_MQTT_PORT=1883
NOTIFY_MQTT_TOPIC=
NOTIFY_MQTT_USERNAME=
NOTIFY_MQTT_PASSWORD=
NOTIFY_MQTT_RETAIN=false

# Email backend settings
NOTIFY_EMAIL_HOST=
NOTIFY_EMAIL_PORT=587
NOTIFY_EMAIL_USERNAME=
NOTIFY_EMAIL_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_USE_TLS=true

# Notification trigger controls
NOTIFY_ON_UPDATES_FOUND=true
NOTIFY_ON_PULL_SUCCESS=false
NOTIFY_ON_PULL_ERROR=true
NOTIFY_ON_RECREATE_SUCCESS=false
NOTIFY_ON_RECREATE_ERROR=true
NOTIFY_ON_BULK_COMPLETE=true

# Remote instance discovery
# Provide a JSON array or point to a file containing remote instance definitions
REMOTE_INSTANCES=
REMOTE_INSTANCES_FILE=remote_instances.example.json

# Registry token cache TTL (seconds)
TOKEN_CACHE_TTL=900
